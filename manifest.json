{
  "manifest_version": 3,
  "name": "Fake Job Shield",
  "version": "1.0.0",
  "description": "Check before you trust. Analyze job listings and recruiter messages for explainable recruitment scam warning signs.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fake Job Shield"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [],
  "host_permissions": [],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
